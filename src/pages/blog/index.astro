---
// Import necessary components, modules and types
import MainLayout from "@/layouts/MainLayout.astro";
import { Image } from "astro:assets";
import { SITE } from "@data/constants";

// Import images for project cards
import blueprints from "@images/blueprints-image.avif";
import personWorking from "@images/person-working.avif";
import beforeAfter from "@images/before-after.avif";
import constructionWorkers from "@images/construction-workers.avif";
import aerialView from "@images/aerial-view.avif";
import usingTools from "@images/using-tools.avif";
import progressBuilding from "@images/progress-building.avif";
import underConstruction from "@images/under-construction.avif";
import automatedTools from "@images/automated-tools.avif";
import heroImage from "@images/hero-image.avif";
import constructionImage from "@images/construction-image.avif";
import featuresImage from "@images/features-image.avif";

// Define project interface
interface Project {
  title: string;
  description: string;
  image: any;
  imageAlt: string;
  link?: string;
}

// FEA & CFD Projects
const feaProjects: Project[] = [
  {
    title: "Structural Stress Analysis",
    description: "Complete FEA of industrial crane arm with load distribution and safety factor optimization.",
    image: beforeAfter,
    imageAlt: "FEA stress analysis visualization",
    link: "/projects/fea/structural-stress-analysis",
  },
  {
    title: "Thermal Management System",
    description: "CFD simulation for electronics enclosure cooling with optimized airflow design.",
    image: aerialView,
    imageAlt: "Thermal simulation results",
    link: "/projects/fea/thermal-management-system",
  },
  {
    title: "Vibration Analysis",
    description: "Modal analysis and vibration study for rotating machinery components.",
    image: progressBuilding,
    imageAlt: "Vibration analysis model",
    link: "/projects/fea/vibration-analysis",
  },
];

// CAD Modeling Projects
const cadProjects: Project[] = [
  {
    title: "Industrial Machine Assembly",
    description: "Complete parametric CAD model with 500+ parts for automated packaging system.",
    image: blueprints,
    imageAlt: "CAD assembly model",
    link: "/projects/cad/industrial-machine-assembly",
  },
  {
    title: "Consumer Product Design",
    description: "Ergonomic product enclosure designed for injection molding with DFM optimization.",
    image: personWorking,
    imageAlt: "Product design CAD",
    link: "/projects/cad/consumer-product-design",
  },
  {
    title: "Sheet Metal Enclosure",
    description: "Complex sheet metal design with proper bend allowances and manufacturing drawings.",
    image: heroImage,
    imageAlt: "Sheet metal CAD design",
    link: "/projects/cad/sheet-metal-enclosure",
  },
  {
    title: "Mechanical Linkage System",
    description: "Kinematic linkage design with motion simulation and interference checking.",
    image: featuresImage,
    imageAlt: "Linkage mechanism CAD",
    link: "/projects/cad/mechanical-linkage-system",
  },
];

// Robotics Projects
const roboticsProjects: Project[] = [
  {
    title: "Autonomous Mobile Robot",
    description: "ROS 2 based AGV with Nav2 navigation stack and custom obstacle avoidance.",
    image: constructionWorkers,
    imageAlt: "Mobile robot project",
    link: "/projects/robotics/autonomous-mobile-robot",
  },
  {
    title: "6-DOF Robotic Arm",
    description: "Industrial manipulator with MoveIt integration and custom gripper design.",
    image: automatedTools,
    imageAlt: "Robotic arm project",
    link: "/projects/robotics/6-dof-robotic-arm",
  },
  {
    title: "Vision-Guided Pick & Place",
    description: "Computer vision system with object detection for automated sorting application.",
    image: constructionImage,
    imageAlt: "Vision system project",
    link: "/projects/robotics/vision-guided-pick-place",
  },
];

// 3D Printing Projects
const printingProjects: Project[] = [
  {
    title: "Functional Prototype",
    description: "Multi-material prototype with living hinges and snap-fit features in PETG and TPU.",
    image: usingTools,
    imageAlt: "3D printed prototype",
    link: "/projects/3d-printing/functional-prototype",
  },
  {
    title: "Production Tooling",
    description: "Custom jigs and fixtures printed in Nylon for manufacturing assembly line.",
    image: underConstruction,
    imageAlt: "3D printed tooling",
    link: "/projects/3d-printing/production-tooling",
  },
  {
    title: "Concept Model",
    description: "High-detail concept model with post-processing finish for client presentation.",
    image: progressBuilding,
    imageAlt: "3D printed concept model",
    link: "/projects/3d-printing/concept-model",
  },
];

// Other Projects
const otherProjects: Project[] = [
  {
    title: "Embedded System Design",
    description: "Custom PCB design with ESP32 for IoT sensor network application.",
    image: aerialView,
    imageAlt: "Embedded system project",
    link: "/projects/other/embedded-system-design",
  },
  {
    title: "Technical Documentation",
    description: "Complete engineering documentation package with assembly and maintenance manuals.",
    image: blueprints,
    imageAlt: "Technical documentation",
    link: "/projects/other/technical-documentation",
  },
  {
    title: "Reverse Engineering",
    description: "3D scanning and CAD reconstruction of legacy parts for manufacturing.",
    image: beforeAfter,
    imageAlt: "Reverse engineering project",
    link: "/projects/other/reverse-engineering",
  },
];

// Page metadata
const pageTitle: string = `Projects | ${SITE.title}`;
const metaDescription =
  "Explore our portfolio of engineering projects spanning FEA analysis, CAD modeling, robotics development, and 3D printing services.";
const ogTitle = "Engineering Projects Portfolio";
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://screwfast.uk/blog",
    url: "https://screwfast.uk/blog",
    name: "Projects | Engineering Portfolio",
    description:
      "Explore our portfolio of engineering projects spanning FEA analysis, CAD modeling, robotics development, and 3D printing services.",
    isPartOf: {
      "@type": "WebSite",
      url: "https://screwfast.uk",
      name: "ScrewFast",
      description:
        "Engineering solutions for the autonomous age.",
    },
    inLanguage: "en-US",
  }}
>
  <!-- Hero Section -->
  <section
    class="mx-auto max-w-[85rem] space-y-8 px-4 pt-16 sm:px-6 lg:px-8 2xl:max-w-full"
  >
    <div class="mx-auto max-w-3xl text-left sm:text-center">
      <h1
        class="block text-4xl font-bold tracking-tight text-balance text-neutral-800 md:text-5xl lg:text-6xl dark:text-neutral-200"
      >
        Our Projects
      </h1>
      <p
        class="mt-4 text-lg text-pretty text-neutral-600 dark:text-neutral-400"
      >
        Explore our portfolio of engineering excellence. From simulation to reality, these projects showcase our capabilities across FEA, CAD, robotics, and rapid prototyping.
      </p>
    </div>
  </section>

  <!-- FEA & CFD Projects Section -->
  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
      <h2
        class="text-2xl font-bold text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200"
      >
        FEA Analysis & CFD
      </h2>
      <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
        Simulation projects that validate designs before manufacturing
      </p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {feaProjects.map((project) => (
        <article class="group relative overflow-hidden rounded-xl">
          <div class="aspect-[16/10] overflow-hidden">
            <Image
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              src={project.image}
              alt={project.imageAlt}
              format={"avif"}
            />
          </div>
          <div class="mt-4">
            <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-200">
              {project.title}
            </h3>
            <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
              {project.description}
            </p>
            <a href={project.link || "#"} class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-orange-500 hover:text-orange-600">
              Read more
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CAD Modeling Projects Section -->
  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
      <h2
        class="text-2xl font-bold text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200"
      >
        CAD Modeling
      </h2>
      <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
        Precision parametric designs optimized for manufacturing
      </p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {cadProjects.map((project) => (
        <article class="group relative overflow-hidden rounded-xl">
          <div class="aspect-[16/10] overflow-hidden">
            <Image
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              src={project.image}
              alt={project.imageAlt}
              format={"avif"}
            />
          </div>
          <div class="mt-4">
            <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-200">
              {project.title}
            </h3>
            <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
              {project.description}
            </p>
            <a href={project.link || "#"} class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-orange-500 hover:text-orange-600">
              Read more
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Robotics Projects Section -->
  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
      <h2
        class="text-2xl font-bold text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200"
      >
        Robotics Project Development
      </h2>
      <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
        End-to-end robotic systems from concept to deployment
      </p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {roboticsProjects.map((project) => (
        <article class="group relative overflow-hidden rounded-xl">
          <div class="aspect-[16/10] overflow-hidden">
            <Image
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              src={project.image}
              alt={project.imageAlt}
              format={"avif"}
            />
          </div>
          <div class="mt-4">
            <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-200">
              {project.title}
            </h3>
            <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
              {project.description}
            </p>
            <a href={project.link || "#"} class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-orange-500 hover:text-orange-600">
              Read more
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- 3D Printing Projects Section -->
  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
      <h2
        class="text-2xl font-bold text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200"
      >
        3D Printing
      </h2>
      <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
        Rapid prototyping and production parts across multiple materials
      </p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {printingProjects.map((project) => (
        <article class="group relative overflow-hidden rounded-xl">
          <div class="aspect-[16/10] overflow-hidden">
            <Image
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              src={project.image}
              alt={project.imageAlt}
              format={"avif"}
            />
          </div>
          <div class="mt-4">
            <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-200">
              {project.title}
            </h3>
            <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
              {project.description}
            </p>
            <a href={project.link || "#"} class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-orange-500 hover:text-orange-600">
              Read more
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Other Projects Section -->
  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
      <h2
        class="text-2xl font-bold text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200"
      >
        Other Projects
      </h2>
      <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
        Additional engineering services and specialized solutions
      </p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {otherProjects.map((project) => (
        <article class="group relative overflow-hidden rounded-xl">
          <div class="aspect-[16/10] overflow-hidden">
            <Image
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              src={project.image}
              alt={project.imageAlt}
              format={"avif"}
            />
          </div>
          <div class="mt-4">
            <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-200">
              {project.title}
            </h3>
            <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
              {project.description}
            </p>
            <a href={project.link || "#"} class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-orange-500 hover:text-orange-600">
              Read more
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA Section -->
  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
    <div class="mx-auto max-w-3xl text-center">
      <div class="rounded-2xl bg-gradient-to-r from-orange-500 to-orange-600 p-10 text-white shadow-xl">
        <h2 class="text-2xl font-bold md:text-3xl">Have a Project in Mind?</h2>
        <p class="mt-4 text-white/90">
          Let's discuss how we can bring your engineering vision to life.
        </p>
        <a
          href="/contact"
          class="mt-6 inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 font-semibold text-orange-600 shadow-md transition hover:bg-neutral-100"
        >
          Start Your Project
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
</MainLayout>
