---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";

// Import necessary images
import blueprints from "@images/blueprints-image.avif";
import personWorking from "@images/person-working.avif";
import beforeAfter from "@images/before-after.avif";
import constructionWorkers from "@images/construction-workers.avif";
import aerialView from "@images/aerial-view.avif";
import usingTools from "@images/using-tools.avif";
import progressBuilding from "@images/progress-building.avif";
import underConstruction from "@images/under-construction.avif";
import automatedTools from "@images/automated-tools.avif";
import { SITE } from "@data/constants";

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

// Main 4 Services
const mainServices: Article[] = [
  {
    isRightSection: true,
    title: "FEA Analysis & CFD",
    subTitle:
      "Validate your engineering before cutting a single piece of metal. We perform rigorous Finite Element Analysis (FEA) including static stress, thermal, and vibration analysis to predict failure points in the digital world. Our Computational Fluid Dynamics (CFD) simulations optimize airflow, heat dissipation, and fluid behavior. This process ensures your designs meet required Safety Factors while optimizing weight and material costs.",
    single: false,
    imgOne: beforeAfter,
    imgOneAlt: "FEA stress analysis visualization",
    imgTwo: aerialView,
    imgTwoAlt: "CFD simulation results",
    btnExists: true,
    btnTitle: "Learn More",
    btnURL: "#",
  },
  {
    isRightSection: false,
    title: "CAD Modeling",
    subTitle:
      "We go beyond simple drafting. Specializing in parametric modeling and advanced surface design, we create fully editable, production-ready CAD files. Whether you need complex sheet metal enclosures, ergonomic consumer parts, or intricate mechanical assemblies, our designs are optimized for manufacturing constraints (DFM) from day one.",
    img: blueprints,
    imgAlt: "Blueprints and digital tablet with CAD designs",
    btnExists: true,
    btnTitle: "View Portfolio",
    btnURL: "/blog",
  },
  {
    isRightSection: true,
    title: "Robotics Project Development",
    subTitle:
      "From concept to deployment, we build complete robotic systems. We develop modular software stacks using the Robot Operating System (ROS 2), covering autonomous navigation (Nav2), robotic manipulation (MoveIt), and custom drivers for embedded controllers like ESP32 and Jetson Nano. Whether it's an AGV, robotic arm, or custom automation solution, we deliver end-to-end robotics development.",
    single: false,
    imgOne: constructionWorkers,
    imgOneAlt: "Robotics development team",
    imgTwo: personWorking,
    imgTwoAlt: "Programming robotic systems",
    btnExists: true,
    btnTitle: "Explore Projects",
    btnURL: "/blog",
  },
  {
    isRightSection: false,
    title: "3D Printing Services",
    subTitle:
      "Transform your concepts into tangible prototypes with our comprehensive 3D printing solutions. We work with a wide range of filaments including PLA for rapid prototyping, ABS for durable functional parts, PETG for chemical resistance, TPU for flexible components, and Nylon for high-strength applications. Our service covers CAD design optimization, slicing configuration, multi-material printing, and post-processing finishing.",
    img: automatedTools,
    imgAlt: "3D printer creating precision parts",
    btnExists: true,
    btnTitle: "Get a Quote",
    btnURL: "/contact",
  },
];

// Other Services
const otherServices: Article[] = [
  {
    isRightSection: true,
    title: "Rapid Prototyping & DFM",
    subTitle:
      "We bridge the gap between digital simulation and physical reality. Using in-house 3D printing and a network of local CNC partners, we validate designs fast. Every component we draw is engineered for Manufacturing (DFM), ensuring that your prototype can actually be mass-produced cost-effectively.",
    single: false,
    imgOne: usingTools,
    imgOneAlt: "Prototyping tools and equipment",
    imgTwo: progressBuilding,
    imgTwoAlt: "Prototype development in progress",
  },
  {
    isRightSection: false,
    title: "Engineered for Impact",
    subTitle:
      "We don't just prioritize aesthetics, we prioritize metrics. From reducing Bill of Materials (BOM) costs to accelerating prototyping cycles, our value is measurable. We optimize your designs for cost-effectiveness without compromising quality.",
    img: underConstruction,
    imgAlt: "Engineering optimization process",
    btnExists: true,
    btnTitle: "Read More",
    btnURL: "#",
  },
];

const pageTitle: string = `Services | ${SITE.title}`;
const metaDescription =
  "Uniting expertise with your vision, ScrewFast provides exceptional service and comprehensive solutions in the hardware and construction industry, from consultation to project completion.";
const ogTitle = "Expert Consultation Services | ScrewFast";
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://screwfast.uk/services",
    url: "https://screwfast.uk/services",
    name: "Expert Consultation Services | ScrewFast",
    description:
      "Uniting expertise with your vision, ScrewFast provides exceptional service and comprehensive solutions in the hardware and construction industry, from consultation to project completion.",
    isPartOf: {
      "@type": "WebSite",
      url: "https://screwfast.uk",
      name: "ScrewFast",
      description:
        "ScrewFast offers top-tier hardware tools and expert construction services to meet all your project needs.",
    },
    inLanguage: "en-US",
  }}
>
  {/* MainSection is the introductory section of the page, it also contains a CTA button */}
  <MainSection
    title="Engineering Solutions for the Autonomous Age"
    subTitle="At [Company Name), we bridge the gap between digital design and physical reality. From complex parametric modeling to full-stack ROS 2 implementation, we provide the technical expertise needed to bring your machines to life."
    btnExists={true}
    btnTitle="Schedule a Consultation"
    btnURL="/contact"
  />
  {/* RightSection and LeftSection contain details about various services along with pertinent imagery.
  They alternate for variety in design.
  The 'btnExists' property is used to toggle the display of a button in these sections.
  When btnExists={true}, a button is displayed.
  This can be used to link to more detailed information or related resources.
  RightSection can also conditionally render one or two images based on the 'single' property.
  If 'single' is true, it displays one image, otherwise it displays two.
  */}
  {/* Main Services */}
  {
    mainServices.map((article) => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }

  {/* Other Services Section Header */}
  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <h2 class="text-3xl font-bold text-neutral-800 dark:text-neutral-200 md:text-4xl md:leading-tight">
        Other Services
      </h2>
      <p class="mt-3 text-neutral-600 dark:text-neutral-400">
        Additional expertise to support your engineering projects
      </p>
    </div>
  </section>

  {/* Other Services */}
  {
    otherServices.map((article) => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }
  {/* FeaturesStats section showcases essential stats valuable to users */}
  <!-- <FeaturesStats
    title="By the Numbers"
    subTitle="Our commitment to quality and reliability is evident in every project we undertake. At ScrewFast, we are dedicated to delivering industry-leading services that ensure your construction projects are built to last."
    mainStatTitle="96%"
    mainStatSubTitle="of our clients rate their experience with ScrewFast as exceptional"
    stats={[
      {
        stat: "99.8%",
        description: "project completion rate",
      },
      {
        stat: "5,000+",
        description: "successful installations",
      },
      {
        stat: "85%",
        description: "client growth year-over-year",
      },
    ]}
  /> -->
</MainLayout>
